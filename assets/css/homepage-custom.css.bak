<style>
/* VinFast Eco-Green Technology Light Mode Overrides */
:root {
  --color-ev-green: #10b981;
  --color-ev-green-hover: #059669;
  --color-ev-cyan: #0ea5e9;
  --color-ev-gold: #d97706;
  --color-bg-light: #f8faf9;
  --color-text-dark: #0f172a;
  --color-text-slate: #475569;
  --glow-green: 0 0 15px rgba(16, 185, 129, 0.25);
  --glow-gold: 0 0 15px rgba(217, 119, 6, 0.25);
  --card-shadow: 0 10px 30px rgba(16, 185, 129, 0.08), 0 1px 3px rgba(0,0,0,0.02);
}

/* 1. Futuristic Hero Overrides (Light Mode Green Tech) */
.hero-stage {
  position: relative;
  overflow: hidden;
  border-bottom: 2px solid rgba(16, 185, 129, 0.15);
  background-size: cover;
  background-position: center;
}
.hero-stage::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(240, 253, 244, 0.5) 0%, rgba(240, 253, 244, 0.8) 100%);
  pointer-events: none;
}
.hero-headline {
  color: var(--color-text-dark) !important;
  text-shadow: 0 2px 10px rgba(255, 255, 255, 0.9);
  font-family: "Montserrat", sans-serif !important;
  font-weight: 900;
  letter-spacing: -0.5px;
}
.hero-subline {
  color: var(--color-text-slate) !important;
  font-weight: 500;
  text-shadow: 0 2px 5px rgba(255, 255, 255, 0.9);
}
.hero-ctas .btn-primary {
  background: linear-gradient(135deg, var(--color-ev-green) 0%, var(--color-ev-green-hover) 100%) !important;
  color: #ffffff !important;
  border: none;
  font-weight: 700;
  box-shadow: var(--glow-green);
  transition: all 0.3s ease;
}
.hero-ctas .btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 25px rgba(16, 185, 129, 0.5);
  background: linear-gradient(135deg, var(--color-ev-green-hover) 0%, #047857) 100%;
}
.hero-ctas .btn-secondary {
  border: 1px solid var(--color-ev-cyan);
  color: var(--color-ev-cyan);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(5px);
  font-weight: 600;
  box-shadow: 0 4px 10px rgba(14, 165, 233, 0.1);
  transition: all 0.3s ease;
}
.hero-ctas .btn-secondary:hover {
  transform: translateY(-2px);
  background: var(--color-ev-cyan);
  color: #fff;
  box-shadow: 0 0 25px rgba(14, 165, 233, 0.4);
}

/* 2. Brand Spotlight Overrides (Green Tech Theme) */
.brand-spotlight {
  background: linear-gradient(180deg, #f0fdf4 0%, var(--color-bg-light) 100%);
  border-bottom: 1px solid rgba(16, 185, 129, 0.1);
  position: relative;
  color: var(--color-text-slate);
}
.spotlight-tag {
  color: var(--color-ev-green) !important;
  font-weight: 700;
  letter-spacing: 2px;
  text-shadow: 0 0 8px rgba(16, 185, 129, 0.15);
}
.spotlight-title {
  color: var(--color-text-dark) !important;
}
.spotlight-desc {
  color: var(--color-text-slate) !important;
}
.spotlight-visual img {
  border-radius: 12px;
  border: 1px solid rgba(16, 185, 129, 0.15);
  box-shadow: var(--card-shadow);
}

/* 3. EV Tech Interactive Center (Eco-Green Light Theme) */
.ev-tech-section {
  padding: 80px 0;
  background: linear-gradient(180deg, var(--color-bg-light) 0%, #f0fdf4 100%);
  border-bottom: 1px solid rgba(16, 185, 129, 0.1);
  position: relative;
}
.ev-tech-section::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image: radial-gradient(rgba(16, 185, 129, 0.06) 1px, transparent 1px);
  background-size: 24px 24px;
  pointer-events: none;
}
.ev-tech-section .section-title {
  color: var(--color-text-dark) !important;
}
.ev-tech-section .section-tag {
  color: var(--color-ev-green) !important;
}
.ev-tech-tabs-wrapper {
  display: flex;
  justify-content: center;
  margin-bottom: 40px;
}
.ev-tech-tabs {
  display: inline-flex;
  background: #e6f4ea;
  border: 1px solid rgba(16, 185, 129, 0.15);
  padding: 6px;
  border-radius: 30px;
  box-shadow: inset 0 2px 4px rgba(0,0,0,0.03);
}
.ev-tech-tab-btn {
  background: transparent;
  border: none;
  color: var(--color-text-slate);
  padding: 12px 28px;
  font-size: 14px;
  font-weight: 600;
  border-radius: 25px;
  cursor: pointer;
  transition: all 0.3s ease;
}
.ev-tech-tab-btn:hover {
  color: var(--color-text-dark);
}
.ev-tech-tab-btn.active {
  background: linear-gradient(135deg, var(--color-ev-green) 0%, var(--color-ev-green-hover) 100%);
  color: #fff;
  box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
}

.ev-tech-pane {
  display: none;
}
.ev-tech-pane.active {
  display: block;
  animation: fadeIn 0.5s ease-in-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Range Calculator Grid (Light mode cards) */
.range-calc-grid {
  display: grid;
  grid-template-columns: 1.2fr 1.8fr;
  gap: 40px;
  align-items: stretch;
}
.range-calc-models-panel {
  background: #ffffff;
  border: 1px solid rgba(16, 185, 129, 0.1);
  box-shadow: var(--card-shadow);
  border-radius: 16px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-height: 520px;
  overflow-y: auto;
}
.range-calc-model-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px;
  background: #f8faf9;
  border: 1px solid rgba(16, 185, 129, 0.08);
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s ease;
}
.range-calc-model-card:hover {
  background: #eefdf5;
  border-color: rgba(16, 185, 129, 0.3);
  transform: translateX(4px);
}
.range-calc-model-card.active {
  background: linear-gradient(90deg, #ecfdf5 0%, #ffffff 100%);
  border-color: var(--color-ev-green);
  box-shadow: 0 4px 15px rgba(16, 185, 129, 0.1);
}
.range-calc-model-thumb {
  width: 70px;
  height: auto;
  object-fit: contain;
}
.range-calc-model-info {
  flex-grow: 1;
}
.range-calc-model-name {
  font-size: 15px;
  font-weight: 700;
  color: var(--color-text-dark);
  margin-bottom: 4px;
}
.range-calc-model-meta {
  font-size: 12px;
  color: var(--color-text-slate);
}

.range-calc-interactive-panel {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
  background: #ffffff;
  border: 1px solid rgba(16, 185, 129, 0.1);
  box-shadow: var(--card-shadow);
  border-radius: 16px;
  padding: 32px;
}
.range-calc-controls {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 30px;
}
.range-slider-group {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.range-slider-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.range-slider-label {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--color-text-slate);
}
.range-slider-value {
  font-size: 15px;
  font-weight: 700;
  color: var(--color-ev-green);
}
.range-slider-input {
  -webkit-appearance: none;
  width: 100%;
  height: 6px;
  border-radius: 3px;
  background: #e2e8f0;
  outline: none;
}
.range-slider-input::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--color-ev-green);
  box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);
  cursor: pointer;
  transition: transform 0.1s;
}
.range-slider-input::-webkit-slider-thumb:hover {
  transform: scale(1.2);
}

.range-calc-visualizer {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
.range-circle-box {
  width: 200px;
  height: 200px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.range-svg-ring {
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}
.range-svg-bg {
  fill: none;
  stroke: #f1f5f9;
  stroke-width: 12;
}
.range-svg-progress {
  fill: none;
  stroke: url(#green-teal-grad);
  stroke-width: 12;
  stroke-linecap: round;
  stroke-dasharray: 565.48;
  stroke-dashoffset: 0;
  transition: stroke-dashoffset 0.3s ease;
  filter: drop-shadow(0 2px 6px rgba(16, 185, 129, 0.3));
}
.range-number-box {
  position: absolute;
  text-align: center;
}
.range-number-value {
  font-size: 38px;
  font-weight: 800;
  color: var(--color-text-dark);
  line-height: 1;
}
.range-number-unit {
  font-size: 13px;
  color: var(--color-ev-green);
  font-weight: 600;
  margin-top: 4px;
}
.range-efficiency-badge {
  margin-top: 20px;
  background: #ecfdf5;
  border: 1px solid rgba(16, 185, 129, 0.2);
  padding: 8px 16px;
  border-radius: 20px;
  font-size: 12px;
  color: var(--color-ev-green);
  font-weight: 600;
}

/* Green ROI Calculator Styling (Light Mode) */
.roi-calc-grid {
  display: grid;
  grid-template-columns: 1.6fr 1.4fr;
  gap: 40px;
  align-items: stretch;
}
.roi-calc-form-panel {
  background: #ffffff;
  border: 1px solid rgba(16, 185, 129, 0.1);
