  border-bottom: 1px solid #f1f5f9 !important;
  border-right: 1px solid #f1f5f9 !important;
}
.compare-spec-table tr:hover td {
  background: #f8faf9 !important;
}

/* Responsive ev-tech */
@media (max-width: 992px) {
  .range-calc-grid {
    grid-template-columns: 1fr;
  }
  .range-calc-models-panel {
    max-height: 250px;
    flex-direction: row;
    overflow-x: auto;
    overflow-y: hidden;
  }
  .range-calc-model-card {
    flex-direction: column;
    min-width: 140px;
    text-align: center;
    padding: 12px;
  }
  .range-calc-model-card:hover {
    transform: translateY(-2px);
  }
  .roi-calc-grid {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 600px) {
  .range-calc-interactive-panel {
    grid-template-columns: 1fr;
    padding: 20px;
  }
  .roi-form-row {
    grid-template-columns: 1fr;
  }
  .roi-calc-form-panel, .roi-results-panel {
    padding: 20px;
  }
}
</style>
';

