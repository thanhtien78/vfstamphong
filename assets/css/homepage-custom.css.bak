}

/* Compare Overrides */
.compare-section {
  background: var(--color-bg-light);
  color: var(--color-text-slate);
}
.compare-title {
  color: var(--color-text-dark) !important;
}
.compare-spec-table {
  background: #ffffff;
  border: 1px solid rgba(16, 185, 129, 0.1);
  box-shadow: var(--card-shadow);
}
.compare-spec-table th {
