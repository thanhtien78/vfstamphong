}
.roi-green-number {
  font-weight: 800;
  font-size: 16px;
}

/* 4. Comparison Pulse Button Custom Override (Rule preference - Light Mode Gold Accent) */
.btn-compare-pulse {
  background: #ffffff !important;
  color: var(--color-ev-gold) !important;
  border: 1.5px solid var(--color-ev-gold) !important;
  padding: 14px 28px !important;
  border-radius: 30px !important;
  font-size: 13.5px !important;
  font-weight: 700 !important;
  letter-spacing: 1.5px !important;
  box-shadow: 0 4px 12px rgba(217, 119, 6, 0.1) !important;
  animation: pulse-gold 2s infinite !important;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
}
.btn-compare-pulse:hover {
  background: var(--color-ev-gold) !important;
  color: #ffffff !important;
  box-shadow: 0 6px 20px rgba(217, 119, 6, 0.4) !important;
  transform: translateY(-2px) !important;
}

@keyframes pulse-gold {
  0% {
    box-shadow: 0 0 0 0 rgba(217, 119, 6, 0.3);
  }
  70% {
    box-shadow: 0 0 0 12px rgba(217, 119, 6, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(217, 119, 6, 0);
  }
}

/* Catalog Overrides */
.catalog-section {
  background: #ffffff;
